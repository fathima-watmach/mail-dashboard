# Only needed when the frontend and backend deploy to separate origins
# (Vercel + Render). Leave unset for local dev — Vite's dev-server proxy
# (vite.config.js) already forwards /api and /auth to localhost:3001.
#
# Set this in Vercel's project settings (Settings > Environment Variables),
# not in a committed .env file — it must be the backend's real deployed
# URL, e.g. https://watmach-mail-dashboard.onrender.com
VITE_API_BASE_URL=
