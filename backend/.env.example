# Copy this file to .env and fill in your real values.
# .env is already in .gitignore - never commit real secrets.

# ---- Supabase / Postgres ----
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ---- Azure AD / Microsoft Graph (Outlook) ----
AZURE_CLIENT_ID=your-azure-client-id
AZURE_TENANT_ID=common
AZURE_CLIENT_SECRET=your-azure-client-secret
# Local dev:
# AZURE_REDIRECT_URI=http://localhost:3001/auth/callback
# Production:
AZURE_REDIRECT_URI=https://your-app.onrender.com/auth/callback

# ---- Zoho Mail ----
ZOHO_CLIENT_ID=your-zoho-client-id
ZOHO_CLIENT_SECRET=your-zoho-client-secret
# Local dev:
# ZOHO_REDIRECT_URI=http://localhost:3001/auth/zoho/callback
# Production:
ZOHO_REDIRECT_URI=https://your-app.onrender.com/auth/zoho/callback

# ---- AI Classification ----
# Gemini is the only supported classifier provider — DeepSeek/Groq/Ollama
# support was removed deliberately (see services/classifier.js, services/llm.js).
# Use an API key from a Google AI Studio project with NO billing account
# attached if possible: free-tier overages then fail (429) instead of costing
# money, as a second layer on top of LLM_MONTHLY_CAP_USD below.
CLASSIFIER_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key                # get from aistudio.google.com
GEMINI_MODEL=gemini-3.5-flash-lite                # used for thread summaries / reply suggestions
GEMINI_CLASSIFY_MODEL=gemini-3.5-flash-lite       # used for email classification

# Hard monthly spend cap, persisted in Postgres (services/llmBudget.js) so it
# holds across restarts/redeploys. Every classifier and thread-summary/
# reply-suggestion call checks this first and refuses once the cap is hit for
# the current UTC month. Defaults to 10 if unset.
LLM_MONTHLY_CAP_USD=10

# ---- App ----
NODE_ENV=production
PORT=3001
SESSION_SECRET=generate-a-long-random-string-here
# Encrypts oauth_tokens at rest (pgcrypto). Generate with: openssl rand -hex 32
# Losing/rotating this key invalidates every stored token — everyone reconnects.
TOKEN_ENCRYPTION_KEY=generate-a-long-random-string-here
# Local dev: FRONTEND_URL=http://localhost:5173
FRONTEND_URL=https://your-app.onrender.com
